pipeline {
    agent any

    tools {
        maven 'Maven-3.8.5'
        jdk 'JDK-17'
    }

    environment {
        DOCKER_CREDENTIALS_ID = 'dockerhub-secret'
        IMAGE_NAME = 'your-dockerhub-username/enterprise-java-app'
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/your-username/enterprise-java-app.git'
            }
        }

        stage('Build & Unit Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                script {
                    def scannerHome = tool 'SonarQubeScanner';
                    withSonarQubeEnv('SonarServer') {
                        sh "${scannerHome}/bin/sonar-scanner \
                        -Dsonar.projectKey=enterprise-java-app \
                        -Dsonar.sources=src/main/java \
                        -Dsonar.java.binaries=target/classes"
                    }
                }
            }
        }
        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh "mvn sonar:sonar"
                }
            }
        }

        stage('Quality Gate Check') {
            steps {
                timeout(time: 1, unit: 'HOURS') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy Container Security Scan') {
            steps {
                sh "trivy image --exit-code 0 --severity HIGH,CRITICAL ${IMAGE_NAME}:${env.BUILD_ID}"
            }
        }

        stage('Docker Build & Push') {
            steps {
                script {
                    docker.withRegistry('https://index.docker.io/v1/', "${DOCKER_CREDENTIALS_ID}") {
                        def customImage = docker.build("${IMAGE_NAME}:${env.BUILD_ID}")
                        customImage.push()
                        customImage.push("latest")
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully! Docker image built, scanned, and pushed.'
        }
        failure {
            echo 'Pipeline failed during execution. Check logs for troubleshooting.'
        }
    }
}
